{
  "name": "computer-query",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "A free, private, in-browser AI assistant for learning that speaks like a ship's computer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "start": "vite --open",
    "setup": "bash scripts/setup.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.79",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "22.19.1",
    "@webgpu/types": "0.1.74",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
